NODE_ENV=development
PORT=3000

# Public URL of the API (used to build magic-link and unsubscribe URLs)
APP_URL=http://localhost:3000
# Where the frontend lives; magic links redirect here with ?token=
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql://tidepool:tidepool@localhost:5433/tidepool?schema=public
REDIS_URL=redis://localhost:6380

JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_DAYS=30
MAGIC_LINK_TTL_MINUTES=15

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Tidepool <digest@tidepool.local>"

# How often (minutes) each blog is re-checked for new posts
FETCH_INTERVAL_MINUTES=60

# Number of proxies in front of the API, so rate limits see each client's own
# IP: 0 locally, 1 behind Railway, 2 behind Cloudflare + Railway. Never more
# than the real number, or clients could spoof their IP with X-Forwarded-For.
TRUST_PROXY=0

# Optional ops alerts to Telegram (new readers, new blogs, errors). See
# docs/Runbooks/Telegram alerts.md. Leave empty to turn alerts off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
